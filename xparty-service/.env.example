PORT=8787
# Comma-separated exact origins. Add your backend's HTTPS origin if you also use its frontend.
ALLOWED_ORIGINS=https://pkx404.github.io,http://localhost:8787,http://127.0.0.1:8787
# Only enable behind a trusted proxy that overwrites/appends X-Forwarded-For correctly.
TRUST_PROXY=0
# Optional in-app YouTube search. Never put this key in frontend config.js.
YOUTUBE_API_KEY=
# For coturn's shared-secret authentication (recommended):
TURN_URLS=
TURN_SECRET=
# Alternatively supply your provider's ICE servers as JSON. These credentials are sent
# to authenticated room members. Prefer short-lived provider credentials or coturn above.
ICE_SERVERS_JSON=
